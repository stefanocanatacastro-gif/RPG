{
  "name": "wrestling-rpg",
  "version": "0.24.0",
  "description": "Kid Chispa and the Seven Belts — a TTYD-style wrestling RPG (Phaser 3 + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vitest run && vite build && node tools/make_artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:browser": "python3 tools/smoke_test.py"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module",
  "milestone": "M1"
}
